@echo off
chcp 65001 >nul
cd /d "%~dp0"

REM ============================================================
REM  테스트 커뮤니티 전용 @라온아 트리거 워처
REM  - 이 방 하나에만 붙는다
REM  - 내 메시지(내닉네임)는 무시한다
REM  - 같은 사람에게 5초 내 재응답 금지
REM  - 세션 최대 30건 응답 후 자동 정지
REM ============================================================

python kt_watch.py ^
  --room "테스트 커뮤니티" ^
  --me "내닉네임" ^
  --triggers "@라온아,@라온" ^
  --interval 5 ^
  --cooldown 5 ^
  --max-replies 30 ^
  --window 25 ^
  --yes

pause
